# Database
DATABASE_URL="postgresql://user:password@localhost:5432/immalert"

# Auth (JWT secret — min 32 chars)
NEXTAUTH_SECRET="your-secret-key-min-32-chars-here"

# Resend (email)
RESEND_API_KEY="re_..."

# App
NEXT_PUBLIC_APP_URL="https://immalert.ro"
ADMIN_EMAIL="admin@immalert.ro"

# Build optimizations (set in Railway Variables too)
PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
NEXT_TELEMETRY_DISABLED=1
